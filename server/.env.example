PORT=5000
# Paste your YouCam API key here:
YOUCAM_API_KEY=
# Optional YouCam API Secret (if provided by your console)
YOUCAM_API_SECRET=
# Set to 'false' only when you want to make real live YouCam calls (burns credits).
# Set to 'true' for local dev & testing (0 credits burned).
YOUCAM_MOCK_MODE=true
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
